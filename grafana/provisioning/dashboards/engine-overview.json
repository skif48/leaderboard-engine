{
  "title": "Engine overview",
  "uid": "engine-overview",
  "tags": [
    "leaderboard-engine"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "VictoriaMetrics",
          "value": "VictoriaMetrics"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Throughput",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP requests/s by route",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(engine_http_requests_total[1m]))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Kafka messages/s: produced vs consumed",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(engine_kafka_writer_messages_total[1m])",
          "legendFormat": "produced (writer)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(engine_kafka_consumer_messages_total{result=\"processed\"}[1m]))",
          "legendFormat": "consumed (worker ok)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rate(engine_kafka_consumer_messages_total{result!=\"processed\"}[1m]))",
          "legendFormat": "failed (worker)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Consumer lag: offsets (exporter) vs message age p99 (engine)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag_sum)",
          "legendFormat": "lag (messages)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(engine_kafka_consumer_message_age_seconds_bucket[1m])) by (vmrange))",
          "legendFormat": "message age p99 (s)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        }
      ]
    },
